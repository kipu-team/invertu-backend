# Copiar este archivo como .env y completar los valores.
# El archivo .env NO se sube a GitHub (esta en .gitignore).

DB_URL=jdbc:postgresql://localhost:5432/db_invertu
DB_USERNAME=postgres
DB_PASSWORD=tu_password_de_postgres

# Clave Base64 de al menos 64 bytes (HS512).
# Se puede generar con: openssl rand -base64 64
JWT_SECRET=pega_aqui_tu_clave_base64
JWT_EXPIRACION_SEGUNDOS=3600

FRONTEND_URL=http://localhost:4200

# Correo (Gmail: contrasena de aplicacion, no la contrasena normal)
MAIL_USERNAME=
MAIL_PASSWORD=

# IA
IA_API_KEY=

# Claude: lectura de comprobantes (console.anthropic.com)
ANTHROPIC_API_KEY=

# Carpeta local de comprobantes
ALMACENAMIENTO_RUTA=comprobantes
